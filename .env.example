# Spotify app (Dashboard → Settings → Basic Information)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local dev: Vite proxies /api to the server on :3001
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# Dev server
HOST=127.0.0.1
PORT=3001
FE_ORIGIN=http://127.0.0.1:5173

# Production values live in .env.prod.example (API on Coolify, FE on Vercel).

# In-memory analyze cache (optional)
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES=200

# Minimum gap between Every Noise API requests in ms (default 200)
EVERY_NOISE_MIN_INTERVAL_MS=200

# Persistent Every Noise artist/canon cache (no TTL; survives restarts when mounted)
# EVERY_NOISE_CACHE_DIR=/data/everynoise-cache
# EVERY_NOISE_CACHE_ADMIN_KEY=change-me-for-docker-clear-via-cli
