# Production API (Coolify on markkop-vps)
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
FE_ORIGIN=https://noise.markkop.dev
COOKIE_DOMAIN=.markkop.dev

# Spotify app (Dashboard → Settings → Basic Information)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://api.noise.markkop.dev/api/auth/callback

# Optional tuning
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES=200
EVERY_NOISE_MIN_INTERVAL_MS=200
