{
  "name": "discover-your-noise",
  "version": "2.0.0",
  "description": "Discover the genres represented in a Spotify playlist — CLI, agent skill, and web app.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "discover-your-noise": ".agents/skills/discover-your-noise/scripts/discover-your-noise.mjs"
  },
  "scripts": {
    "start": "node .agents/skills/discover-your-noise/scripts/discover-your-noise.mjs",
    "test": "node --test",
    "dev": "npm run dev:server",
    "dev:server": "npm run dev -w @discover-your-noise/server",
    "dev:web": "npm run dev -w @discover-your-noise/web"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-skill",
    "spotify",
    "genres",
    "everynoise"
  ],
  "author": "Mark Kop",
  "license": "ISC"
}
